{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Topic Item",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": ["string", "null"],
      "format": "email"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["ML/AI", "Data Science", "Programming", "Creative Arts", "Business/Finance", "Personal Development", "Academic", "Other"]
      }
    },
    "status": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "generated_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": ["ML/AI", "Data Science", "Programming", "Creative Arts", "Business/Finance", "Personal Development", "Academic", "Other"]
          },
          "file": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": ["topic", "category", "file", "status"],
        "additionalProperties": false
      }
    }
  },
  "required": ["id", "timestamp", "name", "topics", "categories", "status", "generated_at", "generated_items"],
  "additionalProperties": false
}