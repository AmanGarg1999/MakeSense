{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Topic Submission",
  "type": "object",
  "properties": {
    "topic": {
      "type": "string",
      "maxLength": 200
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["ML/AI", "Data Science", "Programming", "Creative Arts", "Business/Finance", "Personal Development", "Academic", "Other"]
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "enum": ["web", "api"]
    }
  },
  "required": ["topic"],
  "additionalProperties": true
}