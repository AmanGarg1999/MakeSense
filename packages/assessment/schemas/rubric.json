{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "makesense://schemas/rubric.json",
  "title": "AnalyticRubric",
  "description": "Analytic rubric (LL-01 §5): criteria x levels with anchor exemplars. Analytic > holistic for model-assisted scoring. Anchors are non-negotiable.",
  "type": "object",
  "required": ["rubric_id", "version", "skill_tag", "level_index", "criteria", "levels", "pass_threshold", "escalation_band"],
  "properties": {
    "rubric_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^v[0-9]+(\\.[0-9]+)*$", "description": "Rubric text is prompt-versioned: scoring results cite rubric_id@version." },
    "prompt_version": { "type": "string", "description": "Scoring-prompt template version (paired with prompts/score_rubric.md)." },
    "skill_tag": { "type": "string" },
    "level_index": { "type": "integer", "minimum": 0 },
    "evidence_class": { "enum": ["E1", "E2", "E3", "E4", "E5", "E6", "E7", "E8"], "description": "Primary evidence class this rubric scores (LL-01 §1)." },
    "levels": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["score", "label"],
        "properties": {
          "score": { "type": "integer", "minimum": 0 },
          "label": { "type": "string" },
          "descriptor": { "type": "string" }
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion_id", "name", "weight", "levels"],
        "properties": {
          "criterion_id": { "type": "string" },
          "name": { "type": "string" },
          "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "levels": {
            "type": "object",
            "description": "level score -> description + anchor exemplars.",
            "propertyNames": { "pattern": "^[0-9]+$" },
            "additionalProperties": {
              "type": "object",
              "required": ["description"],
              "properties": {
                "description": { "type": "string" },
                "anchors": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["ref"],
                    "properties": {
                      "ref": { "type": "string", "description": "Artifact ref of a real anchor exemplar (curated corpus)." },
                      "note": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "pass_threshold": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "Weighted score fraction required to pass." },
    "escalation_band": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.5, "description": "Scores within +-band of threshold trigger human escalation / dual-scoring (LL-01 §5b)." }
  }
}
