{
  "manifest_version": 3,
  "name": "MakeSense - Browse to Learn",
  "version": "1.0.0",
  "description": "Turn any webpage or article into interactive, gamified lessons on MakeSense using on-device RunAnywhere AI.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "http://localhost:8090/*",
    "http://127.0.0.1:8090/*",
    "http://100.72.85.102:8090/*"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "MakeSense - Browse to Learn",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
