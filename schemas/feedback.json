{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Feedback Item",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "content_file": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "submission_id": {
      "type": "string"
    },
    "feedback_type": {
      "type": "string",
      "enum": ["up", "down"]
    },
    "user_identifier": {
      "type": "string"
    },
    "comment": {
      "type": ["string", "null"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["id", "content_file", "topic", "submission_id", "feedback_type", "user_identifier", "timestamp"],
  "additionalProperties": false
}